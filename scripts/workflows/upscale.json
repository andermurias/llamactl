{
  "1": {
    "inputs": {"ckpt_name": "cyberrealisticPony_v170.safetensors"},
    "class_type": "CheckpointLoaderSimple",
    "_meta": {"title": "Load Checkpoint"}
  },
  "2": {
    "inputs": {"text": "masterpiece, best quality, highly detailed", "clip": ["1", 1]},
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Positive Prompt"}
  },
  "3": {
    "inputs": {"text": "artifacts, noise, jpeg artifacts, blurry, low quality", "clip": ["1", 1]},
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Negative Prompt"}
  },
  "4": {
    "inputs": {"width": 512, "height": 512, "batch_size": 1},
    "class_type": "EmptyLatentImage",
    "_meta": {"title": "Empty Latent Image"}
  },
  "5": {
    "inputs": {
      "seed": 42, "steps": 20, "cfg": 7,
      "sampler_name": "euler_ancestral", "scheduler": "normal", "denoise": 1,
      "model": ["1", 0], "positive": ["2", 0], "negative": ["3", 0], "latent_image": ["4", 0]
    },
    "class_type": "KSampler",
    "_meta": {"title": "KSampler"}
  },
  "6": {
    "inputs": {"samples": ["5", 0], "vae": ["1", 2]},
    "class_type": "VAEDecode",
    "_meta": {"title": "VAE Decode"}
  },
  "7": {
    "inputs": {"filename_prefix": "llamagen", "images": ["6", 0]},
    "class_type": "SaveImage",
    "_meta": {"title": "Save Image"}
  }
}
